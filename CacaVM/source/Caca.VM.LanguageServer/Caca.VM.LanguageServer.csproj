<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Caca.VM.LanguageServer</RootNamespace>
    <AssemblyName>cil-langserver</AssemblyName>
    <Description>Language Server Protocol implementation for CIL (CacaVM).</Description>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!-- Link the compiler source files directly, same pattern Caca.VM.Cli and
       Caca.VM.Tests use — diagnostics only need the assembler, not the VM runtime. -->
  <ItemGroup>
    <Compile Include="..\Caca.VM.Studio\Compiler\AddressModes.cs" />
    <Compile Include="..\Caca.VM.Studio\Compiler\BuildException.cs" />
    <Compile Include="..\Caca.VM.Studio\Compiler\CharValue.cs" />
    <Compile Include="..\Caca.VM.Studio\Compiler\Compiler.cs" />
    <Compile Include="..\Caca.VM.Studio\Compiler\Instruction.cs" />
    <Compile Include="..\Caca.VM.Studio\Compiler\Registers.cs" />
  </ItemGroup>

</Project>
