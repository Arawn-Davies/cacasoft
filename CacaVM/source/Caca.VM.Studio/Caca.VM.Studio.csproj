<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>Caca.VM.Studio</AssemblyName>
    <RootNamespace>Caca.VM.Studio</RootNamespace>
    <AssemblyTitle>Caca Studio</AssemblyTitle>
    <AssemblyDescription>IDE for Caca Intermediate Language</AssemblyDescription>
    <Company>Arawn-Davies</Company>
    <Product>Caca Studio</Product>
    <Copyright>Copyright © 2024</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Caca.VM\Caca.VM.csproj" />
  </ItemGroup>

  <!--
    cacalang is a sibling directory this project does not build directly.
    When it is present (the same convention cacalang's own test suite
    already uses to find CacaVM), Caca Studio can open a .caca file, compile
    it to CIL for the CacaVM target, and hand the result to its own existing
    assemble/run/debug pipeline unchanged (see MainForm.cs's OpenCacalang,
    guarded by CACALANG_SUPPORT). Conditional, not required: Caca Studio's
    CIL-only functionality must not depend on that directory being present.
  -->
  <PropertyGroup>
    <CacalangCompilerProject>..\..\..\cacalang\src\Caca.Compiler\Caca.Compiler.csproj</CacalangCompilerProject>
    <CacalangCilBackendProject>..\..\..\cacalang\src\Caca.CilBackend\Caca.CilBackend.csproj</CacalangCilBackendProject>
  </PropertyGroup>

  <ItemGroup Condition="Exists('$(CacalangCompilerProject)') And Exists('$(CacalangCilBackendProject)')">
    <ProjectReference Include="$(CacalangCompilerProject)" />
    <ProjectReference Include="$(CacalangCilBackendProject)" />
  </ItemGroup>

  <PropertyGroup Condition="Exists('$(CacalangCompilerProject)') And Exists('$(CacalangCilBackendProject)')">
    <DefineConstants>$(DefineConstants);CACALANG_SUPPORT</DefineConstants>
  </PropertyGroup>

</Project>
