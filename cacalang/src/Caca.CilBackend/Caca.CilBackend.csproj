<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Caca.CilBackend</RootNamespace>
    <AssemblyName>Caca.CilBackend</AssemblyName>
    <Description>
      A cacalang backend targeting CIL, the assembly language of the CacaVM
      virtual machine. Depends on Caca.Compiler's public AST and binding
      types; Caca.Compiler does not depend on this, or know it exists.
    </Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Caca.Compiler\Caca.Compiler.csproj" />
  </ItemGroup>

</Project>
