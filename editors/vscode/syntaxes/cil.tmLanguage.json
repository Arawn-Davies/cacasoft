{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "CIL",
  "scopeName": "source.cil",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#chars" },
    { "include": "#numbers" },
    { "include": "#labels" },
    { "include": "#directives" },
    { "include": "#mnemonics" },
    { "include": "#registers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "name": "comment.line.semicolon.cil", "match": ";.*$" },
        { "name": "comment.line.double-slash.cil", "match": "//.*$" }
      ]
    },
    "strings": {
      "name": "string.quoted.double.cil",
      "begin": "\"",
      "end": "\"",
      "patterns": [{ "name": "constant.character.escape.cil", "match": "\\\\." }]
    },
    "chars": {
      "name": "string.quoted.single.cil",
      "begin": "'",
      "end": "'",
      "patterns": [{ "name": "constant.character.escape.cil", "match": "\\\\." }]
    },
    "numbers": {
      "patterns": [
        { "name": "constant.numeric.hex.cil", "match": "\\b0[xX][0-9A-Fa-f]+\\b" },
        { "name": "constant.numeric.decimal.cil", "match": "\\b[0-9]+\\b" }
      ]
    },
    "labels": {
      "name": "entity.name.function.label.cil",
      "match": "^\\s*[A-Za-z_]\\w*\\s*:"
    },
    "directives": {
      "name": "keyword.control.directive.cil",
      "match": "\\bDB\\b",
      "_comment": "Case-sensitive on purpose: register/mnemonic matching below is case-insensitive to match the assembler, but DB as a bare word is common enough as an identifier fragment elsewhere that case-sensitive avoids over-matching."
    },
    "mnemonics": {
      "name": "keyword.control.mnemonic.cil",
      "match": "(?i)\\b(MOV|MOM|MOE|SWP|TEQ|TNE|TLT|TMT|ADD|SUB|INC|DEC|MUL|DIV|SHL|SHR|ROL|ROR|AND|BOR|XOR|NOT|JMP|CLL|RET|JMT|JMF|CLT|CLF|PSH|POP|INB|INW|IND|OUB|OUW|OUD|SWI|KEI)\\b"
    },
    "registers": {
      "name": "variable.language.register.cil",
      "match": "(?i)\\b(PC|IP|SP|SS|AH|AL|A|BH|BL|B|CH|CL|C|X|Y)\\b"
    }
  }
}
