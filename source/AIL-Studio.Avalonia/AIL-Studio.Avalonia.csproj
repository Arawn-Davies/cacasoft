<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>AIL-Studio.Avalonia</AssemblyName>
    <RootNamespace>AIL_Studio_Avalonia</RootNamespace>
    <AssemblyTitle>AIL Studio (Avalonia)</AssemblyTitle>
    <AssemblyDescription>Cross-platform IDE for Artemis Intermediate Language</AssemblyDescription>
    <Company>Arawn-Davies</Company>
    <Product>AIL Studio</Product>
    <Copyright>Copyright © 2024</Copyright>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.20" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.20" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.20" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.20" />
    <!-- Debug-only, temporary: added to diagnose the blank-TextEditor rendering bug via
         the live Visual Tree inspector (F12). Remove once that's resolved, per the
         earlier decision to keep it out of the MVP otherwise. -->
    <PackageReference Include="Avalonia.Diagnostics" Version="11.3.20" Condition="'$(Configuration)' == 'Debug'" />
    <!-- Pinned to the 11.3.x line to match the Avalonia core packages above — this
         package's version numbers track Avalonia's own release numbers, and a
         higher AvaloniaEdit (11.4.1) against a lower core (11.3.20) rendered nothing
         at all (blank editor, no exceptions) despite correct layout/bounds/visibility. -->
    <PackageReference Include="Avalonia.AvaloniaEdit" Version="11.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Artemis-VM\Artemis_IL.csproj" />
  </ItemGroup>

  <!-- Link the compiler source files (pure logic, no WinForms dependency) directly from
       AIL-Studio, same pattern AIL-Tests already uses. Single source of truth. -->
  <ItemGroup>
    <Compile Include="..\AIL-Studio\Compiler\AddressModes.cs" />
    <Compile Include="..\AIL-Studio\Compiler\BuildException.cs" />
    <Compile Include="..\AIL-Studio\Compiler\CharValue.cs" />
    <Compile Include="..\AIL-Studio\Compiler\Compiler.cs" />
    <Compile Include="..\AIL-Studio\Compiler\Instruction.cs" />
    <Compile Include="..\AIL-Studio\Compiler\Registers.cs" />
  </ItemGroup>

  <!-- Embed the shared example programs directly from /examples — single source of truth,
       no duplicated copies drifting out of sync with the WinForms IDE's embedded strings. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\examples\hello_world_db.ail" LogicalName="hello_world_db.ail" />
    <EmbeddedResource Include="..\..\examples\calculator.ail" LogicalName="calculator.ail" />
  </ItemGroup>

</Project>
