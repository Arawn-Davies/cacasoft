<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="AIL_Studio_Avalonia.Views.InputDialog"
        Title="AIL Studio – Input"
        Width="380" Height="140"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BrushSidebar}">
  <Grid Margin="10" RowDefinitions="Auto,Auto,*,Auto">
    <TextBlock Grid.Row="0" x:Name="PromptText" Foreground="{DynamicResource BrushDefaultText}"
               TextWrapping="Wrap" Margin="0,0,0,8" />
    <TextBox Grid.Row="1" x:Name="InputBox" Background="#FF1E1E1E" Foreground="#FFD4D4D4"
             BorderBrush="{DynamicResource BrushSeparator}" />
    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
      <Button x:Name="OkButton" Content="OK" Width="75"
              Background="{DynamicResource BrushAccent}" Foreground="White" Click="OnOkClick" />
    </StackPanel>
  </Grid>
</Window>
