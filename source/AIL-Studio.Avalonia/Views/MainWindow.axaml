<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ae="using:AvaloniaEdit"
        x:Class="AIL_Studio_Avalonia.Views.MainWindow"
        x:Name="Root"
        Title="AIL Studio"
        Width="1100" Height="760"
        MinWidth="700" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BrushSidebar}">

  <DockPanel>

    <!-- ── Menu ─────────────────────────────────────────────────────────── -->
    <Menu DockPanel.Dock="Top" Background="{DynamicResource BrushToolbar}">
      <MenuItem Header="_File">
        <MenuItem Header="_New" InputGesture="Ctrl+N" Click="OnNewClick" />
        <MenuItem Header="_Open…" InputGesture="Ctrl+O" Click="OnOpenClick" />
        <Separator />
        <MenuItem Header="Load _Example">
          <MenuItem Header="Hello World" Click="OnLoadExampleHelloWorldClick" />
          <MenuItem Header="Calculator" Click="OnLoadExampleCalculatorClick" />
        </MenuItem>
        <Separator />
        <MenuItem Header="_Save" InputGesture="Ctrl+S" Click="OnSaveClick" />
        <MenuItem Header="Save _As…" Click="OnSaveAsClick" />
        <Separator />
        <MenuItem Header="E_xit" Click="OnExitClick" />
      </MenuItem>
      <MenuItem Header="_Edit">
        <MenuItem Header="_Undo" InputGesture="Ctrl+Z" Click="OnUndoClick" />
        <MenuItem Header="_Redo" InputGesture="Ctrl+Y" Click="OnRedoClick" />
        <Separator />
        <MenuItem Header="Cu_t" InputGesture="Ctrl+X" Click="OnCutClick" />
        <MenuItem Header="_Copy" InputGesture="Ctrl+C" Click="OnCopyClick" />
        <MenuItem Header="_Paste" InputGesture="Ctrl+V" Click="OnPasteClick" />
        <Separator />
        <MenuItem Header="Select _All" InputGesture="Ctrl+A" Click="OnSelectAllClick" />
      </MenuItem>
      <MenuItem Header="_Build">
        <MenuItem Header="_Compile" InputGesture="F5" Click="OnCompileClick" />
        <MenuItem Header="Compile &amp; _Run" InputGesture="F6" Click="OnCompileAndRunClick" />
      </MenuItem>
      <MenuItem Header="_Help">
        <MenuItem Header="_About AIL Studio" Click="OnAboutClick" />
      </MenuItem>
    </Menu>

    <!-- ── Toolbar ──────────────────────────────────────────────────────── -->
    <Border DockPanel.Dock="Top" Background="{DynamicResource BrushToolbar}"
            BorderBrush="{DynamicResource BrushSeparator}" BorderThickness="0,0,0,1">
      <StackPanel Orientation="Horizontal" Margin="6,4">
        <Button Content="New" Click="OnNewClick" Margin="2,0" />
        <Button Content="Open" Click="OnOpenClick" Margin="2,0" />
        <Button Content="Save" Click="OnSaveClick" Margin="2,0" />
        <Separator Margin="6,0" />
        <Button Content="Compile (F5)" Click="OnCompileClick" Margin="2,0" />
        <Button Content="Compile &amp; Run (F6)" Click="OnCompileAndRunClick" Margin="2,0" />
      </StackPanel>
    </Border>

    <!-- ── Status bar ───────────────────────────────────────────────────── -->
    <Border DockPanel.Dock="Bottom" Background="{DynamicResource BrushToolbar}"
            BorderBrush="{DynamicResource BrushSeparator}" BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="*,Auto" Margin="8,3">
        <TextBlock Grid.Column="0" x:Name="StatusFile" Text="New file" Foreground="#FFAAAAAA" />
        <TextBlock Grid.Column="1" x:Name="StatusPos" Text="Ln 1, Col 1" Foreground="{DynamicResource BrushLineNumFg}" />
      </Grid>
    </Border>

    <!-- ── Editor / output split ────────────────────────────────────────── -->
    <Grid x:Name="SplitGrid" RowDefinitions="3*,4,2*">

      <ae:TextEditor Grid.Row="0" x:Name="Editor"
                      Background="{DynamicResource BrushBackground}"
                      Foreground="{DynamicResource BrushDefaultText}"
                      ShowLineNumbers="True"
                      FontFamily="Cascadia Code,Consolas,Courier New,monospace"
                      FontSize="14"
                      TextChanged="OnEditorTextChanged" />

      <GridSplitter Grid.Row="1" x:Name="Splitter" Background="{DynamicResource BrushSeparator}"
                    ResizeDirection="Rows" Height="4" HorizontalAlignment="Stretch" />

      <Grid Grid.Row="2" x:Name="OutputContainer" RowDefinitions="22,*"
            Background="{DynamicResource BrushSidebar}">
        <Border Grid.Row="0" Background="{DynamicResource BrushToolbar}">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0" Text="Output" Foreground="#FFCCCCCC"
                       VerticalAlignment="Center" Margin="8,0" FontSize="12" />
            <Button Grid.Column="1" x:Name="UndockButton" Content="⊡" Width="26"
                    Click="OnUndockClick" ToolTip.Tip="Pop out console…" />
          </Grid>
        </Border>
        <ScrollViewer Grid.Row="1" x:Name="OutputScroll" Background="{DynamicResource BrushOutputBackground}">
          <SelectableTextBlock x:Name="OutputText"
                                FontFamily="Cascadia Code,Consolas,Courier New,monospace"
                                FontSize="13" Margin="8,4" TextWrapping="NoWrap" />
        </ScrollViewer>
      </Grid>

    </Grid>

  </DockPanel>

</Window>
