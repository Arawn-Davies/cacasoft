<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AIL_Studio.Maui.MainPage"
             Title="AIL Studio"
             BackgroundColor="#252526">

    <!-- No ContentPage.MenuBarItems: on Mac Catalyst that renders as the native macOS
         system menu bar (top of screen), not an in-window menu — explicitly not wanted
         here. Everything lives in the in-app toolbar below instead. -->

    <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="0">

        <!-- Toolbar row 1 -->
        <Border Grid.Row="0" BackgroundColor="#2D2D30" Padding="6" StrokeThickness="0">
            <HorizontalStackLayout Spacing="6">
                <Button Text="New" Clicked="OnNewClicked" />
                <Button Text="Open" Clicked="OnOpenClicked" />
                <Button Text="Save" Clicked="OnSaveClicked" />
                <Button Text="Save As" Clicked="OnSaveAsClicked" />
                <BoxView WidthRequest="1" Color="#3C3C3C" Margin="4,2" />
                <Button Text="Compile" Clicked="OnCompileClicked" />
                <Button Text="Compile &amp; Run" Clicked="OnCompileAndRunClicked" />
                <BoxView WidthRequest="1" Color="#3C3C3C" Margin="4,2" />
                <Button Text="About" Clicked="OnAboutClicked" />
            </HorizontalStackLayout>
        </Border>

        <!-- Toolbar row 2 — load example -->
        <Border Grid.Row="1" BackgroundColor="#2D2D30" Padding="6,0,6,6" StrokeThickness="0">
            <HorizontalStackLayout Spacing="6">
                <Label Text="Load Example:" TextColor="#AAAAAA" VerticalOptions="Center" />
                <Button Text="Hello World" Clicked="OnLoadExampleHelloWorldClicked" />
                <Button Text="Calculator" Clicked="OnLoadExampleCalculatorClicked" />
            </HorizontalStackLayout>
        </Border>

        <!-- Editor / output split (fixed proportions — MAUI has no built-in interactive
             GridSplitter, unlike Avalonia/WPF; acceptable simplification for the MVP) -->
        <Grid Grid.Row="2" RowDefinitions="3*,2*" RowSpacing="1">
            <HybridWebView x:Name="Editor"
                            Grid.Row="0"
                            HybridRoot="wwwroot"
                            DefaultFile="index.html"
                            RawMessageReceived="OnEditorRawMessageReceived" />

            <Grid Grid.Row="1" RowDefinitions="Auto,*" BackgroundColor="#252526">
                <Label Grid.Row="0" Text="Output" TextColor="#CCCCCC" FontSize="12"
                       Padding="8,4" BackgroundColor="#2D2D30" />
                <ScrollView Grid.Row="1" x:Name="OutputScroll" BackgroundColor="#121212">
                    <Label x:Name="OutputLabel"
                           FontFamily="Courier"
                           FontSize="13"
                           Padding="8,4"
                           LineBreakMode="WordWrap" />
                </ScrollView>
            </Grid>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="3" BackgroundColor="#2D2D30" Padding="8,3" StrokeThickness="0">
            <Grid ColumnDefinitions="*,Auto">
                <Label Grid.Column="0" x:Name="StatusFileLabel" Text="New file" TextColor="#AAAAAA" FontSize="12" />
                <Label Grid.Column="1" x:Name="StatusPosLabel" Text="Ln 1, Col 1" TextColor="#858585" FontSize="12" />
            </Grid>
        </Border>

    </Grid>

</ContentPage>
